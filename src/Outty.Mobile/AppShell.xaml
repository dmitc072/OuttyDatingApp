<?xml version="1.0" encoding="UTF-8" ?>

<Shell
    x:Class="Outty.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Outty.Mobile.Views"
    FlyoutBehavior="Disabled">

    <ShellContent
        Route="LoginPage"
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Shell.TabBarIsVisible="False" />

    <TabBar Route="MainTabs">

        <ShellContent
            Route="HomePage"
            Title="Home"
            ContentTemplate="{DataTemplate views:HomePage}" />

        <ShellContent
            Route="MatchingPage"
            Title="Discover"
            ContentTemplate="{DataTemplate views:MatchingPage}" />

        <ShellContent
            x:Name="MessagesShellContent"
            Route="ConversationsPage"
            Title="Messages" />
            
        <ShellContent
            Route="ProfilePage"
            Title="Profile"
            ContentTemplate="{DataTemplate views:ProfilePage}" />

    </TabBar>

</Shell>