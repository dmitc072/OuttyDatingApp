<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Outty.Mobile.Views.MatchingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Discover"
    BackgroundColor="{AppThemeBinding Light=#F7F7F7, Dark=#121212}">

    <Grid RowDefinitions="Auto,*">

        <!-- Page Header -->
        <Grid
            Grid.Row="0"
            Padding="20,16"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
            ColumnDefinitions="*,Auto">

            <VerticalStackLayout Spacing="2">

                <Label
                    Text="Discover"
                    FontSize="26"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light=#1E1E1E, Dark=White}" />

                <Label
                    Text="Find your next outdoor adventure buddy."
                    FontSize="14"
                    TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />

            </VerticalStackLayout>

        </Grid>

        <Grid Grid.Row="1" Padding="20">

            <!-- Loading State -->
            <VerticalStackLayout
                x:Name="LoadingLayout"
                VerticalOptions="Center"
                Spacing="12"
                IsVisible="True">

                <ActivityIndicator IsRunning="True" Color="#2E7D32" />

                <Label
                    Text="Finding people near you..."
                    HorizontalTextAlignment="Center"
                    TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />

            </VerticalStackLayout>

            <!-- Empty State -->
            <VerticalStackLayout
                x:Name="EmptyLayout"
                VerticalOptions="Center"
                Spacing="10"
                IsVisible="False">

                <Label
                    Text="🍃"
                    FontSize="48"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="No more people nearby"
                    FontSize="20"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    TextColor="{AppThemeBinding Light=#1E1E1E, Dark=White}" />

                <Label
                    Text="Check back later, or try widening your search radius in Settings."
                    FontSize="14"
                    HorizontalTextAlignment="Center"
                    TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />

                <Button
                    Text="Refresh"
                    Clicked="OnRefreshClicked"
                    HorizontalOptions="Center"
                    CornerRadius="10"
                    BackgroundColor="#2E7D32"
                    TextColor="White"
                    Margin="0,10,0,0" />

            </VerticalStackLayout>

            <!-- Candidate Card -->
            <VerticalStackLayout
                x:Name="CardLayout"
                Spacing="18"
                IsVisible="False"
                VerticalOptions="Center">

                <Border
                    Padding="24"
                    StrokeShape="RoundRectangle 20"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">

                    <VerticalStackLayout Spacing="14">

                        <Label
                            Text="🌲"
                            FontSize="60"
                            HorizontalTextAlignment="Center" />

                        <Label
                            x:Name="CandidateNameLabel"
                            FontSize="24"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light=#1E1E1E, Dark=White}" />

                        <Label
                            x:Name="CandidateLocationLabel"
                            FontSize="15"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />

                        <Border
                            Padding="10,6"
                            StrokeShape="RoundRectangle 20"
                            Stroke="Transparent"
                            BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#1B3B22}"
                            HorizontalOptions="Center">

                            <Label
                                x:Name="SharedInterestsLabel"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#2E7D32" />

                        </Border>

                    </VerticalStackLayout>

                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">

                    <Button
                        x:Name="PassButton"
                        Grid.Column="0"
                        Text="✕ Pass"
                        Clicked="OnPassClicked"
                        HeightRequest="54"
                        CornerRadius="14"
                        FontSize="17"
                        FontAttributes="Bold"
                        BackgroundColor="{AppThemeBinding Light=#EEEEEE, Dark=#2A2A2A}"
                        TextColor="{AppThemeBinding Light=#1E1E1E, Dark=White}" />

                    <Button
                        x:Name="LikeButton"
                        Grid.Column="1"
                        Text="💚 Like"
                        Clicked="OnLikeClicked"
                        HeightRequest="54"
                        CornerRadius="14"
                        FontSize="17"
                        FontAttributes="Bold"
                        BackgroundColor="#2E7D32"
                        TextColor="White" />

                </Grid>

                <Label
                    x:Name="RemainingCountLabel"
                    FontSize="12"
                    HorizontalTextAlignment="Center"
                    TextColor="{AppThemeBinding Light=#777777, Dark=#BBBBBB}" />

            </VerticalStackLayout>

        </Grid>

    </Grid>

</ContentPage>
