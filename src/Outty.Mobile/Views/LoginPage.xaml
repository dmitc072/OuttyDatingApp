<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Outty.Mobile.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.0" Color="#183D2B" />
            <GradientStop Offset="0.55" Color="#2F6B4F" />
            <GradientStop Offset="1.0" Color="#89A66F" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="*,Auto">

        <!-- Decorative background circles -->
        <Ellipse
            Margin="-120,-140,0,0"
            Fill="#20FFFFFF"
            HeightRequest="350"
            HorizontalOptions="Start"
            VerticalOptions="Start"
            WidthRequest="350" />

        <Ellipse
            Margin="0,0,-100,-100"
            Fill="#15FFFFFF"
            HeightRequest="300"
            HorizontalOptions="End"
            VerticalOptions="End"
            WidthRequest="300" />

        <ScrollView Grid.RowSpan="2">
            <VerticalStackLayout
                Padding="28"
                Spacing="24"
                VerticalOptions="Center">

                <!-- Branding -->
                <VerticalStackLayout
                    Margin="0,40,0,10"
                    Spacing="8">

                    <Border
                        Padding="18"
                        BackgroundColor="#30FFFFFF"
                        HeightRequest="88"
                        HorizontalOptions="Center"
                        StrokeThickness="0"
                        WidthRequest="88">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="44" />
                        </Border.StrokeShape>

                        <Label
                            FontSize="42"
                            HorizontalOptions="Center"
                            Text="⛰"
                            TextColor="White"
                            VerticalOptions="Center" />
                    </Border>

                    <Label
                        FontAttributes="Bold"
                        FontSize="48"
                        HorizontalTextAlignment="Center"
                        Text="Outty"
                        TextColor="White" />

                    <Label
                        FontSize="18"
                        HorizontalTextAlignment="Center"
                        LineHeight="1.2"
                        Text="Find your next adventure partner."
                        TextColor="#E8F2EA" />
                </VerticalStackLayout>

                <!-- Login card -->
                <Border
                    Padding="26"
                    BackgroundColor="#F7FFFFFF"
                    Stroke="#30FFFFFF"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow
                            Brush="#50000000"
                            Offset="0,8"
                            Opacity="0.35"
                            Radius="18" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="18">

                        <Label
                            FontAttributes="Bold"
                            FontSize="26"
                            HorizontalTextAlignment="Center"
                            Text="Welcome to Outty"
                            TextColor="#183D2B" />

                        <Label
                            FontSize="15"
                            HorizontalTextAlignment="Center"
                            LineHeight="1.3"
                            Text="Connect with people who enjoy hiking, camping, traveling, and exploring the outdoors."
                            TextColor="#5D665F" />

                        <Button
                            x:Name="GoogleLoginButton"
                            Margin="0,12,0,0"
                            BackgroundColor="White"
                            BorderColor="#D6DCD8"
                            BorderWidth="1"
                            Clicked="OnGoogleLoginClicked"
                            CornerRadius="14"
                            FontAttributes="Bold"
                            FontSize="16"
                            HeightRequest="58"
                            Text="G   Continue with Google"
                            TextColor="#2D332F" />

                        <ActivityIndicator
                            x:Name="LoginActivityIndicator"
                            Color="#2F6B4F"
                            HorizontalOptions="Center"
                            IsRunning="False"
                            IsVisible="False" />

                        <Label
                            x:Name="ErrorLabel"
                            FontSize="14"
                            HorizontalTextAlignment="Center"
                            IsVisible="False"
                            TextColor="#B3261E" />

                        <Label
                            FontSize="12"
                            HorizontalTextAlignment="Center"
                            LineHeight="1.3"
                            Text="By continuing, you agree to Outty's Terms of Service and Privacy Policy."
                            TextColor="#737C76" />

                    </VerticalStackLayout>
                </Border>

                <Label
                    Margin="0,4,0,30"
                    FontSize="13"
                    HorizontalTextAlignment="Center"
                    Text="Adventure is better together."
                    TextColor="#E8F2EA" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>