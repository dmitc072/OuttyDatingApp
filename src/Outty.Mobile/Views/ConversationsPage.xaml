<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Outty.Mobile.Views.ConversationsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:messaging="clr-namespace:Outty.Shared.Models.Messaging;assembly=Outty.Shared"
    Title="Messages">

    <Grid
        Padding="20"
        RowDefinitions="Auto,*">

        <Label
            Grid.Row="0"
            Margin="0,0,0,16"
            FontAttributes="Bold"
            FontSize="28"
            Text="Messages" />

        <RefreshView
            x:Name="ConversationsRefreshView"
            Grid.Row="1"
            Command="{Binding RefreshCommand}"
            IsRefreshing="{Binding IsRefreshing}">

            <CollectionView
                x:Name="ConversationsCollectionView"
                EmptyView="You do not have any conversations yet."
                ItemsSource="{Binding Conversations}"
                SelectionChanged="OnConversationSelected"
                SelectionMode="Single">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="messaging:ConversationSummaryDto">

                        <Border
                            Margin="0,0,0,12"
                            Padding="14"
                            Stroke="#D9D9D9"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1">

                            <Grid
                                ColumnDefinitions="*,Auto"
                                RowDefinitions="Auto,Auto,Auto">

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    Text="{Binding OtherUserName}" />

                                <Border
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Padding="8,3"
                                    BackgroundColor="#512BD4"
                                    IsVisible="{Binding HasUnreadMessages}"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="0">

                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        Text="{Binding UnreadCount}"
                                        TextColor="White" />
                                </Border>

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="0,5,0,0"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1"
                                    Text="{Binding LastMessage}"
                                    TextColor="Gray" />

                                <Label
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="0,5,0,0"
                                    FontSize="12"
                                    HorizontalOptions="End"
                                    Text="{Binding LastMessageTimeText}"
                                    TextColor="Gray" />

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>