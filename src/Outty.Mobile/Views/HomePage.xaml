<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Outty.Mobile.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Home"
    BackgroundColor="#F4F1E8">

    <ScrollView>

        <VerticalStackLayout
            Padding="24"
            Spacing="24">

            <!-- Header -->

            <VerticalStackLayout
                HorizontalOptions="Center"
                Spacing="8">

                <Label
                    FontAttributes="Bold"
                    FontSize="34"
                    HorizontalTextAlignment="Center"
                    Text="Welcome"
                    TextColor="#183D2B" />

                <Label
                    x:Name="WelcomeNameLabel"
                    FontAttributes="Bold"
                    FontSize="28"
                    HorizontalTextAlignment="Center"
                    Text="Adventurer!"
                    TextColor="#2F6B4F" />

                <Label
                    FontSize="15"
                    HorizontalTextAlignment="Center"
                    Text="Ready to find your next outdoor adventure?"
                    TextColor="#667267" />

            </VerticalStackLayout>

            <!-- Hero Card -->

            <Border
                Padding="20"
                BackgroundColor="White"
                Stroke="#D7DDD8"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18"/>
                </Border.StrokeShape>

                <VerticalStackLayout
                    Spacing="12">

                    <Label
                        FontAttributes="Bold"
                        FontSize="22"
                        Text="Adventure Awaits"
                        TextColor="#183D2B" />

                    <Label
                        FontSize="15"
                        Text="Discover hiking partners, camping buddies, kayaking groups, and more. Build your profile and start connecting with fellow outdoor enthusiasts."
                        TextColor="#555555" />

                    <Button
                        BackgroundColor="#2F6B4F"
                        Clicked="OnStartExploringClicked"
                        CornerRadius="14"
                        FontAttributes="Bold"
                        HeightRequest="52"
                        Text="Start Exploring"
                        TextColor="White" />

                </VerticalStackLayout>

            </Border>

            <!-- Navigation -->

            <Label
                FontAttributes="Bold"
                FontSize="20"
                Text="Quick Actions"
                TextColor="#183D2B" />

            <VerticalStackLayout
                Spacing="14">

                <Button
                    BackgroundColor="#2F6B4F"
                    Clicked="OnProfileClicked"
                    CornerRadius="14"
                    FontAttributes="Bold"
                    HeightRequest="52"
                    Text="View Profile"
                    TextColor="White" />

                <Button
                    BackgroundColor="Transparent"
                    BorderColor="#2F6B4F"
                    BorderWidth="1"
                    Clicked="OnSettingsClicked"
                    CornerRadius="14"
                    FontAttributes="Bold"
                    HeightRequest="52"
                    Text="Settings"
                    TextColor="#2F6B4F" />

            </VerticalStackLayout>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>