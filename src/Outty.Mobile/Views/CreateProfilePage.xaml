<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Outty.Mobile.Views.CreateProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Create Profile"
    BackgroundColor="#F4F1E8">

    <ScrollView>
        <VerticalStackLayout
            Padding="24"
            Spacing="18">

            <!-- Page header -->

            <Label
                FontAttributes="Bold"
                FontSize="34"
                Text="Create Your Profile"
                TextColor="#183D2B" />

            <Label
                FontSize="15"
                Text="Tell other adventurers who you are and what you enjoy."
                TextColor="#667267" />

            <!-- Profile photos -->

            <Grid
                Margin="0,8,0,0"
                ColumnDefinitions="*,Auto">

                <VerticalStackLayout Spacing="3">
                    <Label
                        FontAttributes="Bold"
                        FontSize="20"
                        Text="Profile Photos"
                        TextColor="#183D2B" />

                    <Label
                        FontSize="13"
                        Text="Add at least one photo. You may upload up to six."
                        TextColor="#667267" />
                </VerticalStackLayout>

                <Label
                    x:Name="PhotoCountLabel"
                    Grid.Column="1"
                    FontAttributes="Bold"
                    Text="0 / 6"
                    TextColor="#2F6B4F"
                    VerticalOptions="Center" />

            </Grid>

            <Border
                Padding="15"
                BackgroundColor="#E4EAE3"
                Stroke="#C6D0C8"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <CollectionView
                        x:Name="PhotoCollectionView"
                        HeightRequest="180"
                        HorizontalScrollBarVisibility="Never"
                        ItemsSource="{Binding Photos}"
                        ItemsLayout="HorizontalList"
                        SelectionMode="None">

                        <CollectionView.EmptyView>
                            <VerticalStackLayout
                                HorizontalOptions="Center"
                                Spacing="8"
                                VerticalOptions="Center">

                                <Label
                                    FontSize="42"
                                    HorizontalTextAlignment="Center"
                                    Text="📷" />

                                <Label
                                    FontAttributes="Bold"
                                    HorizontalTextAlignment="Center"
                                    Text="No photos added"
                                    TextColor="#34463A" />

                                <Label
                                    FontSize="12"
                                    HorizontalTextAlignment="Center"
                                    Text="Choose photos from your device."
                                    TextColor="#667267" />

                            </VerticalStackLayout>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    Margin="0,0,12,0"
                                    HeightRequest="160"
                                    WidthRequest="125">

                                    <Border
                                        BackgroundColor="White"
                                        Stroke="#C6D0C8"
                                        StrokeThickness="1">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>

                                        <Image
                                            Aspect="AspectFill"
                                            Source="{Binding ImageSource}" />

                                    </Border>

                                    <Button
                                        Margin="0,-6,-6,0"
                                        Padding="0"
                                        BackgroundColor="#B3261E"
                                        Clicked="OnRemovePhotoClicked"
                                        CommandParameter="{Binding .}"
                                        CornerRadius="16"
                                        FontAttributes="Bold"
                                        FontSize="13"
                                        HeightRequest="32"
                                        HorizontalOptions="End"
                                        Text="✕"
                                        TextColor="White"
                                        VerticalOptions="Start"
                                        WidthRequest="32" />

                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="12">

                        <Button
                            BackgroundColor="#2F6B4F"
                            Clicked="OnChoosePhotosClicked"
                            CornerRadius="12"
                            FontAttributes="Bold"
                            HeightRequest="50"
                            Text="Choose Photos"
                            TextColor="White" />

                        <Button
                            Grid.Column="1"
                            BackgroundColor="White"
                            BorderColor="#2F6B4F"
                            BorderWidth="1"
                            Clicked="OnTakePhotoClicked"
                            CornerRadius="12"
                            FontAttributes="Bold"
                            HeightRequest="50"
                            Text="Take Photo"
                            TextColor="#2F6B4F" />

                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- Display name -->

            <Label
                FontAttributes="Bold"
                Text="Display Name"
                TextColor="#183D2B" />

            <Border
                BackgroundColor="White"
                Stroke="#D7DDD8"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Entry
                    x:Name="NameEntry"
                    Margin="12,4"
                    Placeholder="Enter your display name"
                    PlaceholderColor="#727B74"
                    TextColor="#222222" />

            </Border>

            <!-- Date of birth -->

            <Label
                FontAttributes="Bold"
                Text="Date of Birth"
                TextColor="#183D2B" />

            <Border
                BackgroundColor="White"
                Stroke="#D7DDD8"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <DatePicker
                    x:Name="BirthDatePicker"
                    DateSelected="OnBirthDateSelected"
                    Margin="12,4"
                    TextColor="#222222" />

            </Border>

            <Label
                x:Name="AgeLabel"
                FontSize="13"
                Text="You must be at least 18 years old."
                TextColor="#667267" />

            <!-- Location -->

            <Label
                FontAttributes="Bold"
                Text="Location"
                TextColor="#183D2B" />

            <Border
                BackgroundColor="White"
                Stroke="#D7DDD8"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Entry
                    x:Name="CityEntry"
                    Margin="12,4"
                    Placeholder="City"
                    PlaceholderColor="#727B74"
                    TextColor="#222222" />

            </Border>

            <Grid
                ColumnDefinitions="2*,3,1*"
                ColumnSpacing="10">

                <Border
                    Grid.Column="0"
                    BackgroundColor="White"
                    Stroke="#D7DDD8"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <Picker
                        x:Name="StatePicker"
                        Margin="12,4"
                        TextColor="#222222"
                        Title="State"
                        TitleColor="#727B74">

                        <Picker.Items>
                            <x:String>AL</x:String>
                            <x:String>AK</x:String>
                            <x:String>AZ</x:String>
                            <x:String>AR</x:String>
                            <x:String>CA</x:String>
                            <x:String>CO</x:String>
                            <x:String>CT</x:String>
                            <x:String>DE</x:String>
                            <x:String>DC</x:String>
                            <x:String>FL</x:String>
                            <x:String>GA</x:String>
                            <x:String>HI</x:String>
                            <x:String>ID</x:String>
                            <x:String>IL</x:String>
                            <x:String>IN</x:String>
                            <x:String>IA</x:String>
                            <x:String>KS</x:String>
                            <x:String>KY</x:String>
                            <x:String>LA</x:String>
                            <x:String>ME</x:String>
                            <x:String>MD</x:String>
                            <x:String>MA</x:String>
                            <x:String>MI</x:String>
                            <x:String>MN</x:String>
                            <x:String>MS</x:String>
                            <x:String>MO</x:String>
                            <x:String>MT</x:String>
                            <x:String>NE</x:String>
                            <x:String>NV</x:String>
                            <x:String>NH</x:String>
                            <x:String>NJ</x:String>
                            <x:String>NM</x:String>
                            <x:String>NY</x:String>
                            <x:String>NC</x:String>
                            <x:String>ND</x:String>
                            <x:String>OH</x:String>
                            <x:String>OK</x:String>
                            <x:String>OR</x:String>
                            <x:String>PA</x:String>
                            <x:String>RI</x:String>
                            <x:String>SC</x:String>
                            <x:String>SD</x:String>
                            <x:String>TN</x:String>
                            <x:String>TX</x:String>
                            <x:String>UT</x:String>
                            <x:String>VT</x:String>
                            <x:String>VA</x:String>
                            <x:String>WA</x:String>
                            <x:String>WV</x:String>
                            <x:String>WI</x:String>
                            <x:String>WY</x:String>
                        </Picker.Items>

                    </Picker>

                </Border>

                <Border
                    Grid.Column="2"
                    BackgroundColor="White"
                    Stroke="#D7DDD8"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <Entry
                        x:Name="ZipCodeEntry"
                        Margin="12,4"
                        Keyboard="Numeric"
                        MaxLength="5"
                        Placeholder="ZIP"
                        PlaceholderColor="#727B74"
                        TextColor="#222222" />

                </Border>

            </Grid>

            <!-- Pronouns -->

            <Label
                FontAttributes="Bold"
                Text="Pronouns"
                TextColor="#183D2B" />

            <Border
                BackgroundColor="White"
                Stroke="#D7DDD8"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Picker
                    x:Name="PronounsPicker"
                    Margin="12,4"
                    TextColor="#222222"
                    Title="Select pronouns"
                    TitleColor="#727B74">

                    <Picker.Items>
                        <x:String>She/Her</x:String>
                        <x:String>He/Him</x:String>
                        <x:String>They/Them</x:String>
                        <x:String>She/They</x:String>
                        <x:String>He/They</x:String>
                        <x:String>Prefer not to say</x:String>
                    </Picker.Items>

                </Picker>

            </Border>

            <!-- Bio -->

            <Grid ColumnDefinitions="*,Auto">
                <Label
                    FontAttributes="Bold"
                    Text="Bio"
                    TextColor="#183D2B" />

                <Label
                    x:Name="BioCountLabel"
                    Grid.Column="1"
                    FontSize="12"
                    Text="0 / 300"
                    TextColor="#667267" />
            </Grid>

            <Border
                BackgroundColor="White"
                Stroke="#D7DDD8"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Editor
                    x:Name="BioEditor"
                    Margin="12"
                    AutoSize="TextChanges"
                    BackgroundColor="Transparent"
                    HeightRequest="120"
                    MaxLength="300"
                    Placeholder="Share your personality and favorite adventures..."
                    PlaceholderColor="#727B74"
                    TextChanged="OnBioTextChanged"
                    TextColor="#222222" />

            </Border>

            <!-- Travel distance -->

            <Label
                FontAttributes="Bold"
                Text="Preferred Adventure Distance"
                TextColor="#183D2B" />

            <Border
                BackgroundColor="White"
                Stroke="#D7DDD8"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Picker
                    x:Name="DistancePicker"
                    Margin="12,4"
                    TextColor="#222222"
                    Title="Select preferred distance"
                    TitleColor="#727B74">

                    <Picker.Items>
                        <x:String>Within 10 miles</x:String>
                        <x:String>Within 25 miles</x:String>
                        <x:String>Within 50 miles</x:String>
                        <x:String>Within 100 miles</x:String>
                        <x:String>Anywhere</x:String>
                    </Picker.Items>

                </Picker>

            </Border>

            <!-- Looking for -->

            <Label
                FontAttributes="Bold"
                Text="What Are You Looking For?"
                TextColor="#183D2B" />

            <Border
                Padding="14"
                BackgroundColor="White"
                Stroke="#D7DDD8"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="8">

                    <Grid ColumnDefinitions="Auto,*">
                        <CheckBox x:Name="FriendsCheckBox" />
                        <Label
                            Grid.Column="1"
                            Text="Friends"
                            TextColor="#222222"
                            VerticalOptions="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*">
                        <CheckBox x:Name="PartnersCheckBox" />
                        <Label
                            Grid.Column="1"
                            Text="Adventure Partners"
                            TextColor="#222222"
                            VerticalOptions="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*">
                        <CheckBox x:Name="DatingCheckBox" />
                        <Label
                            Grid.Column="1"
                            Text="Dating"
                            TextColor="#222222"
                            VerticalOptions="Center" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*">
                        <CheckBox x:Name="GroupsCheckBox" />
                        <Label
                            Grid.Column="1"
                            Text="Group Activities"
                            TextColor="#222222"
                            VerticalOptions="Center" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- Outdoor interests -->

            <Label
                FontAttributes="Bold"
                FontSize="20"
                Text="Outdoor Interests"
                TextColor="#183D2B" />

            <Label
                FontSize="12"
                Text="Check an activity and set your experience level for it"
                TextColor="#727B74" />

            <Border
                Padding="14"
                BackgroundColor="White"
                Stroke="#D7DDD8"
                StrokeThickness="1">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="Auto,*">
                            <CheckBox
                                x:Name="HikingCheckBox"
                                CheckedChanged="OnInterestCheckedChanged" />
                            <Label
                                Grid.Column="1"
                                Text="🥾 Hiking"
                                TextColor="#222222"
                                VerticalOptions="Center" />
                        </Grid>
                        <Picker
                            x:Name="HikingExperiencePicker"
                            IsVisible="False"
                            MinimumHeightRequest="44"
                            Title="Experience level"
                            TitleColor="#727B74"
                            TextColor="#222222">
                            <Picker.Items>
                                <x:String>Beginner</x:String>
                                <x:String>Intermediate</x:String>
                                <x:String>Advanced</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="Auto,*">
                            <CheckBox
                                x:Name="CampingCheckBox"
                                CheckedChanged="OnInterestCheckedChanged" />
                            <Label
                                Grid.Column="1"
                                Text="🏕 Camping"
                                TextColor="#222222"
                                VerticalOptions="Center" />
                        </Grid>
                        <Picker
                            x:Name="CampingExperiencePicker"
                            IsVisible="False"
                            MinimumHeightRequest="44"
                            Title="Experience level"
                            TitleColor="#727B74"
                            TextColor="#222222">
                            <Picker.Items>
                                <x:String>Beginner</x:String>
                                <x:String>Intermediate</x:String>
                                <x:String>Advanced</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="Auto,*">
                            <CheckBox
                                x:Name="KayakingCheckBox"
                                CheckedChanged="OnInterestCheckedChanged" />
                            <Label
                                Grid.Column="1"
                                Text="🚣 Kayaking"
                                TextColor="#222222"
                                VerticalOptions="Center" />
                        </Grid>
                        <Picker
                            x:Name="KayakingExperiencePicker"
                            IsVisible="False"
                            MinimumHeightRequest="44"
                            Title="Experience level"
                            TitleColor="#727B74"
                            TextColor="#222222">
                            <Picker.Items>
                                <x:String>Beginner</x:String>
                                <x:String>Intermediate</x:String>
                                <x:String>Advanced</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="Auto,*">
                            <CheckBox
                                x:Name="ClimbingCheckBox"
                                CheckedChanged="OnInterestCheckedChanged" />
                            <Label
                                Grid.Column="1"
                                Text="🧗 Rock Climbing"
                                TextColor="#222222"
                                VerticalOptions="Center" />
                        </Grid>
                        <Picker
                            x:Name="ClimbingExperiencePicker"
                            IsVisible="False"
                            MinimumHeightRequest="44"
                            Title="Experience level"
                            TitleColor="#727B74"
                            TextColor="#222222">
                            <Picker.Items>
                                <x:String>Beginner</x:String>
                                <x:String>Intermediate</x:String>
                                <x:String>Advanced</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="Auto,*">
                            <CheckBox
                                x:Name="CyclingCheckBox"
                                CheckedChanged="OnInterestCheckedChanged" />
                            <Label
                                Grid.Column="1"
                                Text="🚲 Cycling"
                                TextColor="#222222"
                                VerticalOptions="Center" />
                        </Grid>
                        <Picker
                            x:Name="CyclingExperiencePicker"
                            IsVisible="False"
                            MinimumHeightRequest="44"
                            Title="Experience level"
                            TitleColor="#727B74"
                            TextColor="#222222">
                            <Picker.Items>
                                <x:String>Beginner</x:String>
                                <x:String>Intermediate</x:String>
                                <x:String>Advanced</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="Auto,*">
                            <CheckBox
                                x:Name="TravelCheckBox"
                                CheckedChanged="OnInterestCheckedChanged" />
                            <Label
                                Grid.Column="1"
                                Text="🗺 Travel and Road Trips"
                                TextColor="#222222"
                                VerticalOptions="Center" />
                        </Grid>
                        <Picker
                            x:Name="TravelExperiencePicker"
                            IsVisible="False"
                            MinimumHeightRequest="44"
                            Title="Experience level"
                            TitleColor="#727B74"
                            TextColor="#222222">
                            <Picker.Items>
                                <x:String>Beginner</x:String>
                                <x:String>Intermediate</x:String>
                                <x:String>Advanced</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Error message -->

            <Label
                x:Name="ErrorLabel"
                FontAttributes="Bold"
                IsVisible="False"
                TextColor="#B3261E" />

            <!-- Submit button -->

            <Button
                Margin="0,16,0,30"
                BackgroundColor="#2F6B4F"
                Clicked="OnSaveProfileClicked"
                CornerRadius="14"
                FontAttributes="Bold"
                FontSize="18"
                HeightRequest="58"
                Text="Create Profile"
                TextColor="White" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>