<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Outty.Mobile.Views.CreateProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Create Profile"
    BackgroundColor="{AppThemeBinding Light=#F7F7F7, Dark=#121212}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <Grid RowDefinitions="Auto,*">

        <!-- Page Header -->
        <Grid
            Grid.Row="0"
            Padding="20,16"
            BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
            ColumnDefinitions="*,Auto">

            <VerticalStackLayout Spacing="2">

                <Label
                    Text="Create Your Profile"
                    FontSize="26"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light=#1E1E1E, Dark=White}" />

                <Label
                    Text="Tell us about yourself and your outdoor interests."
                    FontSize="14"
                    TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />

            </VerticalStackLayout>

        </Grid>

        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="20"
                Spacing="22">

                <!-- Profile Photos -->
                <Border
                    Padding="18"
                    StrokeShape="RoundRectangle 16"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">

                    <VerticalStackLayout Spacing="14">

                        <Label
                            Text="Profile Photos"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light=#1E1E1E, Dark=White}" />

                        <Label
                            Text="You can add up to six photos."
                            FontSize="14"
                            TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />

                        <CollectionView
                            x:Name="PhotosCollectionView"
                            ItemsSource="{Binding Photos}"
                            HeightRequest="230"
                            SelectionMode="None">

                            <CollectionView.ItemsLayout>
                                <GridItemsLayout
                                    Orientation="Vertical"
                                    Span="3"
                                    HorizontalItemSpacing="10"
                                    VerticalItemSpacing="10" />
                            </CollectionView.ItemsLayout>

                            <CollectionView.ItemTemplate>
                                <DataTemplate>

                                    <Grid
                                        HeightRequest="100"
                                        WidthRequest="100">

                                        <Border
                                            StrokeShape="RoundRectangle 12"
                                            Stroke="{AppThemeBinding Light=#DDDDDD, Dark=#444444}">

                                            <Image
                                                Source="{Binding FilePath}"
                                                Aspect="AspectFill" />

                                        </Border>

                                        <Button
                                            Text="✕"
                                            FontSize="12"
                                            WidthRequest="30"
                                            HeightRequest="30"
                                            Padding="0"
                                            CornerRadius="15"
                                            HorizontalOptions="End"
                                            VerticalOptions="Start"
                                            TranslationX="5"
                                            TranslationY="-5"
                                            BackgroundColor="#CC000000"
                                            TextColor="White"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnRemovePhotoClicked" />

                                    </Grid>

                                </DataTemplate>
                            </CollectionView.ItemTemplate>

                        </CollectionView>

                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="12">

                            <Button
                                Grid.Column="0"
                                Text="Choose Photo"
                                Clicked="OnChoosePhotoClicked"
                                CornerRadius="10"
                                HeightRequest="48"
                                BackgroundColor="#2E7D32"
                                TextColor="White" />

                            <Button
                                Grid.Column="1"
                                Text="Take Photo"
                                Clicked="OnTakePhotoClicked"
                                CornerRadius="10"
                                HeightRequest="48"
                                BackgroundColor="#455A64"
                                TextColor="White" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>

                <!-- Basic Information -->
                <Border
                    Padding="18"
                    StrokeShape="RoundRectangle 16"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">

                    <VerticalStackLayout Spacing="14">

                        <Label
                            Text="Basic Information"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light=#1E1E1E, Dark=White}" />

                        <Label
                            Text="Display Name"
                            FontAttributes="Bold" />

                        <Entry
                            x:Name="DisplayNameEntry"
                            Placeholder="Enter your display name"
                            ClearButtonVisibility="WhileEditing"
                            MaxLength="50" />

                        <Label
                            Text="Date of Birth"
                            FontAttributes="Bold" />

                        <DatePicker
                            x:Name="DateOfBirthPicker"
                            Format="MMMM d, yyyy" />

                        <Label
                            Text="About Me"
                            FontAttributes="Bold" />

                        <Editor
                            x:Name="BioEditor"
                            Placeholder="Tell other users about yourself..."
                            AutoSize="TextChanges"
                            HeightRequest="120"
                            MaxLength="500" />

                        <Label
                            Text="500 character maximum"
                            FontSize="12"
                            HorizontalOptions="End"
                            TextColor="{AppThemeBinding Light=#777777, Dark=#BBBBBB}" />

                    </VerticalStackLayout>

                </Border>

                <!-- Location -->
                <Border
                    Padding="18"
                    StrokeShape="RoundRectangle 16"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">

                    <VerticalStackLayout Spacing="14">

                        <Label
                            Text="Location"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light=#1E1E1E, Dark=White}" />

                        <Label
                            Text="Your ZIP Code will be used for matching and will not be shown publicly."
                            FontSize="13"
                            TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}" />

                        <Label
                            Text="City"
                            FontAttributes="Bold" />

                        <Entry
                            x:Name="CityEntry"
                            Placeholder="Enter your city"
                            Keyboard="Text"
                            ClearButtonVisibility="WhileEditing"
                            MaxLength="100" />

                        <Label
                            Text="State"
                            FontAttributes="Bold" />

                        <Picker
                            x:Name="StatePicker"
                            Title="Select your state">

                            <Picker.Items>
                                <x:String>AL</x:String>
                                <x:String>AK</x:String>
                                <x:String>AZ</x:String>
                                <x:String>AR</x:String>
                                <x:String>CA</x:String>
                                <x:String>CO</x:String>
                                <x:String>CT</x:String>
                                <x:String>DE</x:String>
                                <x:String>FL</x:String>
                                <x:String>GA</x:String>
                                <x:String>HI</x:String>
                                <x:String>ID</x:String>
                                <x:String>IL</x:String>
                                <x:String>IN</x:String>
                                <x:String>IA</x:String>
                                <x:String>KS</x:String>
                                <x:String>KY</x:String>
                                <x:String>LA</x:String>
                                <x:String>ME</x:String>
                                <x:String>MD</x:String>
                                <x:String>MA</x:String>
                                <x:String>MI</x:String>
                                <x:String>MN</x:String>
                                <x:String>MS</x:String>
                                <x:String>MO</x:String>
                                <x:String>MT</x:String>
                                <x:String>NE</x:String>
                                <x:String>NV</x:String>
                                <x:String>NH</x:String>
                                <x:String>NJ</x:String>
                                <x:String>NM</x:String>
                                <x:String>NY</x:String>
                                <x:String>NC</x:String>
                                <x:String>ND</x:String>
                                <x:String>OH</x:String>
                                <x:String>OK</x:String>
                                <x:String>OR</x:String>
                                <x:String>PA</x:String>
                                <x:String>RI</x:String>
                                <x:String>SC</x:String>
                                <x:String>SD</x:String>
                                <x:String>TN</x:String>
                                <x:String>TX</x:String>
                                <x:String>UT</x:String>
                                <x:String>VT</x:String>
                                <x:String>VA</x:String>
                                <x:String>WA</x:String>
                                <x:String>WV</x:String>
                                <x:String>WI</x:String>
                                <x:String>WY</x:String>
                            </Picker.Items>

                        </Picker>

                        <Label
                            Text="ZIP Code"
                            FontAttributes="Bold" />

                        <Entry
                            x:Name="ZipCodeEntry"
                            Placeholder="Enter your five-digit ZIP Code"
                            Keyboard="Numeric"
                            ClearButtonVisibility="WhileEditing"
                            MaxLength="5" />

                    </VerticalStackLayout>

                </Border>

                <!-- Outdoor Preferences -->
                <Border
                    Padding="18"
                    StrokeShape="RoundRectangle 16"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">

                    <VerticalStackLayout Spacing="14">

                        <Label
                            Text="Outdoor Preferences"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light=#1E1E1E, Dark=White}" />

                        <Label
                            Text="Select Your Interests"
                            FontAttributes="Bold" />

                        <Label
                            Text="Check an activity and set your experience level for it"
                            FontSize="12"
                            TextColor="{AppThemeBinding Light=#727B74, Dark=#AAAAAA}" />

                        <VerticalStackLayout Spacing="14">

                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="8">
                                    <CheckBox
                                        x:Name="HikingCheckBox"
                                        CheckedChanged="OnInterestCheckedChanged" />
                                    <Label Text="Hiking" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Picker
                                    x:Name="HikingExperiencePicker"
                                    IsVisible="False"
                                    MinimumHeightRequest="44"
                                    Title="Experience level">
                                    <Picker.Items>
                                        <x:String>Beginner</x:String>
                                        <x:String>Intermediate</x:String>
                                        <x:String>Advance</x:String>
                                    </Picker.Items>
                                </Picker>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="8">
                                    <CheckBox
                                        x:Name="CampingCheckBox"
                                        CheckedChanged="OnInterestCheckedChanged" />
                                    <Label Text="Camping" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Picker
                                    x:Name="CampingExperiencePicker"
                                    IsVisible="False"
                                    MinimumHeightRequest="44"
                                    Title="Experience level">
                                    <Picker.Items>
                                        <x:String>Beginner</x:String>
                                        <x:String>Intermediate</x:String>
                                        <x:String>Advance</x:String>
                                    </Picker.Items>
                                </Picker>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="8">
                                    <CheckBox
                                        x:Name="KayakingCheckBox"
                                        CheckedChanged="OnInterestCheckedChanged" />
                                    <Label Text="Kayaking" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Picker
                                    x:Name="KayakingExperiencePicker"
                                    IsVisible="False"
                                    MinimumHeightRequest="44"
                                    Title="Experience level">
                                    <Picker.Items>
                                        <x:String>Beginner</x:String>
                                        <x:String>Intermediate</x:String>
                                        <x:String>Advance</x:String>
                                    </Picker.Items>
                                </Picker>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="8">
                                    <CheckBox
                                        x:Name="FishingCheckBox"
                                        CheckedChanged="OnInterestCheckedChanged" />
                                    <Label Text="Fishing" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Picker
                                    x:Name="FishingExperiencePicker"
                                    IsVisible="False"
                                    MinimumHeightRequest="44"
                                    Title="Experience level">
                                    <Picker.Items>
                                        <x:String>Beginner</x:String>
                                        <x:String>Intermediate</x:String>
                                        <x:String>Advance</x:String>
                                    </Picker.Items>
                                </Picker>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="8">
                                    <CheckBox
                                        x:Name="CyclingCheckBox"
                                        CheckedChanged="OnInterestCheckedChanged" />
                                    <Label Text="Cycling" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Picker
                                    x:Name="CyclingExperiencePicker"
                                    IsVisible="False"
                                    MinimumHeightRequest="44"
                                    Title="Experience level">
                                    <Picker.Items>
                                        <x:String>Beginner</x:String>
                                        <x:String>Intermediate</x:String>
                                        <x:String>Advance</x:String>
                                    </Picker.Items>
                                </Picker>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="8">
                                    <CheckBox
                                        x:Name="RunningCheckBox"
                                        CheckedChanged="OnInterestCheckedChanged" />
                                    <Label Text="Running" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Picker
                                    x:Name="RunningExperiencePicker"
                                    IsVisible="False"
                                    MinimumHeightRequest="44"
                                    Title="Experience level">
                                    <Picker.Items>
                                        <x:String>Beginner</x:String>
                                        <x:String>Intermediate</x:String>
                                        <x:String>Advance</x:String>
                                    </Picker.Items>
                                </Picker>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="8">
                                    <CheckBox
                                        x:Name="ClimbingCheckBox"
                                        CheckedChanged="OnInterestCheckedChanged" />
                                    <Label Text="Climbing" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Picker
                                    x:Name="ClimbingExperiencePicker"
                                    IsVisible="False"
                                    MinimumHeightRequest="44"
                                    Title="Experience level">
                                    <Picker.Items>
                                        <x:String>Beginner</x:String>
                                        <x:String>Intermediate</x:String>
                                        <x:String>Advance</x:String>
                                    </Picker.Items>
                                </Picker>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <HorizontalStackLayout Spacing="8">
                                    <CheckBox
                                        x:Name="OtherInterestCheckBox"
                                        CheckedChanged="OnInterestCheckedChanged" />
                                    <Label Text="Other" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Picker
                                    x:Name="OtherInterestExperiencePicker"
                                    IsVisible="False"
                                    MinimumHeightRequest="44"
                                    Title="Experience level">
                                    <Picker.Items>
                                        <x:String>Beginner</x:String>
                                        <x:String>Intermediate</x:String>
                                        <x:String>Advance</x:String>
                                    </Picker.Items>
                                </Picker>
                            </VerticalStackLayout>

                        </VerticalStackLayout>

                    </VerticalStackLayout>

                </Border>

                <!-- Search Radius -->
                <Border
                    Padding="18"
                    StrokeShape="RoundRectangle 16"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}">

                    <VerticalStackLayout Spacing="14">

                        <Label
                            Text="Search Preferences"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light=#1E1E1E, Dark=White}" />

                        <Grid ColumnDefinitions="*,Auto">

                            <Label
                                Grid.Column="0"
                                Text="Maximum Search Distance"
                                FontAttributes="Bold"
                                VerticalOptions="Center" />

                            <Label
                                Grid.Column="1"
                                x:Name="SearchRadiusLabel"
                                Text="25 miles"
                                FontAttributes="Bold"
                                TextColor="#2E7D32"
                                VerticalOptions="Center" />

                        </Grid>

                        <Slider
                            x:Name="SearchRadiusSlider"
                            Minimum="5"
                            Maximum="100"
                            Value="25"
                            ValueChanged="OnSearchRadiusChanged" />

                        <Grid ColumnDefinitions="*,*">

                            <Label
                                Grid.Column="0"
                                Text="5 miles"
                                FontSize="12"
                                TextColor="{AppThemeBinding Light=#777777, Dark=#BBBBBB}" />

                            <Label
                                Grid.Column="1"
                                Text="100 miles"
                                FontSize="12"
                                HorizontalOptions="End"
                                TextColor="{AppThemeBinding Light=#777777, Dark=#BBBBBB}" />

                        </Grid>

                    </VerticalStackLayout>

                </Border>

                <!-- Save Button -->
                <Button
                    x:Name="SaveProfileButton"
                    Text="Save Profile"
                    Clicked="OnSaveProfileClicked"
                    HeightRequest="54"
                    CornerRadius="14"
                    FontSize="17"
                    FontAttributes="Bold"
                    BackgroundColor="#2E7D32"
                    TextColor="White" />

                <ActivityIndicator
                    x:Name="SavingIndicator"
                    IsVisible="False"
                    IsRunning="False"
                    HorizontalOptions="Center" />

                <Label
                    Text="You can update your profile later from Settings."
                    FontSize="12"
                    HorizontalTextAlignment="Center"
                    TextColor="{AppThemeBinding Light=#777777, Dark=#BBBBBB}"
                    Margin="0,0,0,20" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>