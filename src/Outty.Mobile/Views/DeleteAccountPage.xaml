<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Outty.Mobile.Views.DeleteAccountPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Delete Account">

    <ScrollView>

        <VerticalStackLayout
            Padding="24"
            Spacing="20">

            <Label
                Text="Delete Your Account"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="#B3261E" />

            <Label
                Text="This action will remove the profile information saved on this device. This cannot be undone."
                FontSize="16" />

            <Border
                Padding="16"
                Stroke="#B3261E"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="#FFF2F2">

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Before continuing:"
                        FontAttributes="Bold"
                        TextColor="#B3261E" />

                    <Label
                        Text="Type DELETE below to confirm that you want to delete your account."
                        TextColor="Black" />

                </VerticalStackLayout>

            </Border>

            <Entry
                x:Name="ConfirmationEntry"
                Placeholder="Type DELETE"
                TextChanged="OnConfirmationTextChanged"
                MaxLength="6" />

            <Button
                x:Name="DeleteAccountButton"
                Text="Permanently Delete Account"
                Clicked="OnDeleteAccountClicked"
                IsEnabled="False"
                BackgroundColor="#B3261E"
                TextColor="White"
                HeightRequest="52"
                CornerRadius="12" />

            <Button
                Text="Cancel"
                Clicked="OnCancelClicked"
                BackgroundColor="Transparent"
                TextColor="#555555" />

            <ActivityIndicator
                x:Name="DeletingIndicator"
                IsVisible="False"
                IsRunning="False" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>